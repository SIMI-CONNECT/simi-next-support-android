<?xml version="1.0" encoding="utf-8"?>
<!--
  Simi Next Support theme overrides.

  Upstream RustDesk shipped Theme.Light.NoTitleBar parents here, which
  produced a flash of white between process-start and Flutter drawing
  the first frame. Customer feedback on v0.1.3 (Dromana panel) was
  that the screen "looked wrong" — white background where black +
  SIMI logo were expected. We override:
    - LaunchTheme  -> Black.NoTitleBar.Fullscreen (splash window)
    - NormalTheme  -> Black.NoTitleBar (post-splash window background
      that sits behind Flutter while it initialises)
  Both windows have @color/simi_brand_black as their windowBackground
  so the cross-fade between native splash and Flutter is invisible.
-->
<resources>
    <!-- Theme applied while the process is starting (system-theme = light). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied once Flutter is initialising; sits behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/simi_brand_black</item>
    </style>
    <style name="Transparent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
