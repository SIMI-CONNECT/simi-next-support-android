    <string name="simi_rendezvous_server" translatable="false">${simiRendezvousServer}</string>
    <string name="simi_rs_pub_key"        translatable="false">${simiRsPubKey}</string>
    <string name="simi_api_server"        translatable="false">${simiApiServer}</string>
    <string name="simi_backend_base_url"  translatable="false">${simiBackendBaseUrl}</string>
</resources>
