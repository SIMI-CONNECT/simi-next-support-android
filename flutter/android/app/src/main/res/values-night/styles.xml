<?xml version="1.0" encoding="utf-8"?>
<!--
  Simi Next Support theme overrides (dark-mode variant).

  Same black-on-black treatment as values/styles.xml; we keep dark and
  light variants in lockstep because the customer-promised first-run
  visual is identical regardless of system theme.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/simi_brand_black</item>
    </style>
</resources>
